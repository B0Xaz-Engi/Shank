	miscTab:CreateButton({
		Name = "Server Hop",
		Tooltip = "Find and join a different server",
		Callback = function()
			if serverHopCooldown then
				window:Notify({Title = "Void", Content = "Please wait...", Duration = 2, Type = "Warning"})
				return
			end
			serverHopCooldown = true
			task.delay(5, function()
				serverHopCooldown = false
			end)
			window:Notify({Title = "Void", Content = "Scanning servers...", Duration = 2, Type = "Info"})
			local ok, result = pcall(function()
				return HttpService:JSONDecode(game:HttpGet(`https://games.roblox.com/v1/games/{game.PlaceId}/servers/Public?sortOrder=Asc&limit=100`))
			end)
			if not ok or not result or not result.data then
				window:Notify({Title = "Void", Content = "Server fetch failed", Duration = 3, Type = "Error"})
				return
			end
			for _, server in ipairs(result.data) do
				if server.id ~= game.JobId and server.playing and server.maxPlayers and server.playing < server.maxPlayers then
					window:Notify({Title = "Void", Content = "Server found - teleporting", Duration = 2, Type = "Success"})
					task.delay(1, function()
						TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, localPlayer)
					end)
					return
				end
			end
			window:Notify({Title = "Void", Content = "No available servers", Duration = 3, Type = "Error"})
		end,
	})

