	task.wait(1.2)
	fadeOutAndDestroy(loadFrame, 0.2)
	task.wait(0.25)

	-- Main window
	local main = mk("Frame", {
		Name = "Main",
		BackgroundColor3 = CONFIG.BG1,
		Size = UDim2.new(0, wW * 0.9, 0, wH * 0.9),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ClipsDescendants = true,
		BackgroundTransparency = 0.2,
		Parent = gui,
	}) :: Frame
	applyCorner(main, cr)
	local mainStroke = applyStroke(main, CONFIG.BORDER, 1, 0.1)
	tw(main, CONFIG.ANIM_POP, {Size = UDim2.new(0, wW, 0, wH), BackgroundTransparency = 0})
	local origSize = UDim2.new(0, wW, 0, wH)

	-- Topbar
	local topbar = mk("Frame", {
		Name = "Topbar",
		BackgroundColor3 = CONFIG.BG2,
		Size = UDim2.new(1, 0, 0, topH),
		BorderSizePixel = 0,
		Parent = main,
	}) :: Frame
	mk("Frame", {
		BackgroundColor3 = CONFIG.BORDER_DIM,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Parent = topbar,
	})
	mk("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, sn(14), 0, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		Text = winTitle,
		TextColor3 = CONFIG.TEXT_BRIGHT,
		Font = UI_FONT_SEMI,
		TextSize = sn(15),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = topbar,
	})

	local btnSize = sn(26)
	local function windowBtn(text: string, xOff: number): TextButton
		local btn = mk("TextButton", {
			BackgroundColor3 = CONFIG.BG3,
			BackgroundTransparency = 0.3,
			Size = UDim2.new(0, btnSize, 0, btnSize),
			Position = UDim2.new(1, xOff, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Text = text,
			TextColor3 = CONFIG.TEXT_SUB,
			Font = UI_FONT_BOLD,
			TextSize = sn(14),
			AutoButtonColor = false,
			Parent = topbar,
		}) :: TextButton
		applyCorner(btn, sn(6))
		btn.MouseEnter:Connect(function()
			tw(btn, CONFIG.ANIM_HOVER_GROW, {
				BackgroundColor3 = CONFIG.BG_HOVER,
				BackgroundTransparency = 0,
				TextColor3 = CONFIG.TEXT_BRIGHT,
				Size = UDim2.new(0, btnSize + sn(2), 0, btnSize + sn(2)),
			})
		end)
		btn.MouseLeave:Connect(function()
			tw(btn, CONFIG.ANIM_HOVER_SHRINK, {
				BackgroundColor3 = CONFIG.BG3,
				BackgroundTransparency = 0.3,
				TextColor3 = CONFIG.TEXT_SUB,
				Size = UDim2.new(0, btnSize, 0, btnSize),
			})
		end)
		return btn
	end

	local closeBtn = windowBtn("×", -sn(10) - btnSize)
	local minBtn = windowBtn("–", -sn(16) - btnSize * 2)
	makeDragHandler(main, topbar)

	local windowOpen = true
	local windowMin = false

	local function fadeAllDescendants(targetTransparency: number)
		for _, child in ipairs(main:GetDescendants()) do
			pcall(function()
				if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") then
					tw(child, CONFIG.ANIM_QUICK, {TextTransparency = targetTransparency})
				elseif child:IsA("Frame") or child:IsA("ScrollingFrame") then
					tw(child, CONFIG.ANIM_QUICK, {BackgroundTransparency = targetTransparency})
				elseif child:IsA("UIStroke") then
					tw(child, CONFIG.ANIM_QUICK, {Transparency = targetTransparency})
				end
			end)
		end
	end

	local function closeWindow()
		if not windowOpen then return end
		windowOpen = false
		tw(main, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(0, wW * 0.95, 0, wH * 0.95), BackgroundTransparency = 1})
		tw(mainStroke, CONFIG.ANIM_QUICK, {Transparency = 1})
		fadeAllDescendants(1)
		task.delay(0.3, function()
			if main and main.Parent then
				main.Visible = false
			end
		end)
	end

	local function openWindow()
		if windowOpen then return end
		windowOpen = true
		windowMin = false
		main.Visible = true
		main.BackgroundTransparency = 0
		main.Size = UDim2.new(0, wW * 0.93, 0, wH * 0.93)
		for _, child in ipairs(main:GetDescendants()) do
			pcall(function()
				if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") then
					child.TextTransparency = child:GetAttribute("_oTT") or 0
				elseif child:IsA("Frame") or child:IsA("ScrollingFrame") then
					child.BackgroundTransparency = child:GetAttribute("_oBT") or 0
				elseif child:IsA("UIStroke") then
					child.Transparency = child:GetAttribute("_oST") or 0
				end
			end)
		end
		tw(main, CONFIG.ANIM_POP, {Size = origSize, BackgroundTransparency = 0})
		tw(mainStroke, CONFIG.ANIM_SNAPPY, {Transparency = 0.1})
	end

	closeBtn.MouseButton1Click:Connect(function()
		closeWindow()
		VoidUI:Notify({Title = "Void", Content = `Press {toggleKey.Name} to reopen`, Duration = 3, Type = "Info"})
	end)

	minBtn.MouseButton1Click:Connect(function()
		windowMin = not windowMin
		tw(main, CONFIG.ANIM_SMOOTH, {Size = windowMin and UDim2.new(0, wW, 0, topH + 2) or origSize})
	end)

	addConnection("WinToggle", UIS.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == toggleKey then
			if windowOpen then
				closeWindow()
			else
				openWindow()
			end
		end
	end))

	if isMobile then
		local inset = GuiService:GetGuiInset()
		local mobBtn = mk("TextButton", {
			Name = "MobileToggle",
			BackgroundColor3 = CONFIG.BG2,
			Size = UDim2.new(0, sn(48), 0, sn(40)),
			Position = UDim2.new(0, sn(8), 0, sn(inset.Y + 8)),
			Text = "Void",
			TextColor3 = CONFIG.TEXT_BRIGHT,
			Font = UI_FONT_BOLD,
			TextSize = sn(11),
			AutoButtonColor = false,
			Parent = gui,
		}) :: TextButton
		applyCorner(mobBtn, sn(10))
		applyStroke(mobBtn, CONFIG.BORDER, 1, 0.15)

		local mDragging = false
		local mDragStart: Vector3? = nil
		local mDragPos: UDim2? = nil

		mobBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				mDragging = true
				mDragStart = input.Position
				mDragPos = mobBtn.Position
			end
		end)

		UIS.InputChanged:Connect(function(input)
			if mDragging and input.UserInputType == Enum.UserInputType.Touch and mDragStart and mDragPos then
				local d = input.Position - mDragStart
				if d.Magnitude > 10 then
					mobBtn.Position = UDim2.new(mDragPos.X.Scale, mDragPos.X.Offset + d.X, mDragPos.Y.Scale, mDragPos.Y.Offset + d.Y)
				end
			end
		end)

		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch and mDragging then
				if mDragStart and (input.Position - mDragStart).Magnitude <= 10 then
					if windowOpen then
						closeWindow()
					else
						openWindow()
					end
				end
				mDragging = false
				mDragStart = nil
				mDragPos = nil
			end
		end)
	end

	-- Tab strip
	local tabStrip = mk("Frame", {
		Name = "TabStrip",
		BackgroundColor3 = CONFIG.BG2,
		Size = UDim2.new(0, tabW, 1, -topH - 1),
		Position = UDim2.new(0, 0, 0, topH + 1),
		BorderSizePixel = 0,
		Parent = main,
	}) :: Frame
	mk("Frame", {
		BackgroundColor3 = CONFIG.BORDER_DIM,
		Size = UDim2.new(0, 1, 1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		BorderSizePixel = 0,
		Parent = tabStrip,
	})
	local tabScroll = mk("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = tabStrip,
	}) :: ScrollingFrame
	applyLayout(tabScroll, sn(6))
	applyPadding(tabScroll, sn(10), sn(8), sn(10), sn(8))

	local contentArea = mk("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -tabW, 1, -topH - 1),
		Position = UDim2.new(0, tabW, 0, topH + 1),
		ClipsDescendants = true,
		Parent = main,
	}) :: Frame

	local allTabs: {any} = {}
	local allTabBtns: {any} = {}
	local activeTab: any = nil
	local winObj: {[string]: any} = {}
	winObj._gui = gui
	winObj._main = main

	function winObj:Notify(notifCfg: {[string]: any}?)
		VoidUI:Notify(notifCfg)
	end

	function winObj:StoreTransparencies()
		task.defer(function()
			for _, child in ipairs(main:GetDescendants()) do
				pcall(function()
					if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") then
						child:SetAttribute("_oTT", child.TextTransparency)
					elseif child:IsA("Frame") or child:IsA("ScrollingFrame") then
						child:SetAttribute("_oBT", child.BackgroundTransparency)
					elseif child:IsA("UIStroke") then
						child:SetAttribute("_oST", child.Transparency)
					end
				end)
			end
		end)
	end

	function winObj:CreateTab(name: string)
		local tabData: {[string]: any} = {_name = name, _elements = {}, _searchElements = {}}

		local pageWrapper = mk("Frame", {
			Name = `PageWrap_{name}`,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			Visible = false,
			Parent = contentArea,
		}) :: Frame

		local searchBar = mk("TextBox", {
			BackgroundColor3 = CONFIG.BG_INPUT,
			Size = UDim2.new(1, -sn(24), 0, sn(30)),
			Position = UDim2.new(0, sn(12), 0, sn(10)),
			Text = "",
			PlaceholderText = "Search",
			PlaceholderColor3 = CONFIG.TEXT_MUTED,
			TextColor3 = CONFIG.TEXT,
			Font = UI_FONT,
			TextSize = sn(11),
			ClearTextOnFocus = false,
			Parent = pageWrapper,
		}) :: TextBox
		applyCorner(searchBar, sn(8))
		local searchStroke = applyStroke(searchBar, CONFIG.BORDER_DIM, 1, 0.3)

		local page = mk("ScrollingFrame", {
			Name = `Page_{name}`,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, -sn(48)),
			Position = UDim2.new(0, 0, 0, sn(46)),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			ScrollBarThickness = sn(3),
			ScrollBarImageColor3 = CONFIG.SCROLL,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = pageWrapper,
		}) :: ScrollingFrame
		applyLayout(page, sn(4))
		applyPadding(page, sn(4), sn(10), sn(12), sn(10))

		tabData._page = page
		tabData._wrapper = pageWrapper

		searchBar:GetPropertyChangedSignal("Text"):Connect(function()
			local query = searchBar.Text:lower()
			for _, entry in ipairs(tabData._searchElements) do
				entry.frame.Visible = query == "" or entry.name:lower():find(query, 1, true) ~= nil
			end
		end)
		searchBar.Focused:Connect(function()
			tw(searchStroke, CONFIG.ANIM_QUICK, {Color = CONFIG.BORDER_GLOW, Transparency = 0.1})
		end)
		searchBar.FocusLost:Connect(function()
			tw(searchStroke, CONFIG.ANIM_SNAPPY, {Color = CONFIG.BORDER_DIM, Transparency = 0.3})
		end)

		local tabBtnWrap = mk("Frame", {
			Name = `TabWrap_{name}`,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, sn(40)),
			Parent = tabScroll,
		}) :: Frame

		local tabGlow = mk("Frame", {
			Name = "Glow",
			BackgroundColor3 = CONFIG.TAB_GLOW,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, sn(8), 0, sn(44)),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 0,
			Parent = tabBtnWrap,
		}) :: Frame
		applyCorner(tabGlow, sn(12))

		local tabBtn = mk("TextButton", {
			Name = `Tab_{name}`,
			BackgroundColor3 = CONFIG.BG3,
			BackgroundTransparency = 0.15,
			Size = UDim2.new(1, 0, 0, sn(36)),
			Position = UDim2.new(0, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Text = name,
			TextColor3 = CONFIG.TEXT_SUB,
			Font = UI_FONT,
			TextSize = sn(12),
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			ZIndex = 2,
			Parent = tabBtnWrap,
		}) :: TextButton
		applyCorner(tabBtn, sn(8))
		applyPadding(tabBtn, 0, sn(10), 0, sn(14))

		table.insert(allTabs, tabData)
		table.insert(allTabBtns, {btn = tabBtn, glow = tabGlow, wrapper = pageWrapper, data = tabData})

		local function selectTab()
			activeTab = tabData
			for _, tb in ipairs(allTabBtns) do
				local isActive = tb.data == tabData
				tb.wrapper.Visible = isActive
				tw(tb.btn, CONFIG.ANIM_SMOOTH, {
					BackgroundColor3 = isActive and CONFIG.BG_CARD_ACTIVE or CONFIG.BG3,
					BackgroundTransparency = isActive and 0 or 0.15,
					TextColor3 = isActive and CONFIG.TEXT_BRIGHT or CONFIG.TEXT_SUB,
				})
				tw(tb.glow, CONFIG.ANIM_SLOW, {BackgroundTransparency = isActive and 0.82 or 1})
			end
		end

		tabBtn.MouseButton1Click:Connect(function()
			selectTab()
			rippleFx(tabBtn, tabBtn.AbsolutePosition.X + tabBtn.AbsoluteSize.X / 2, tabBtn.AbsolutePosition.Y + tabBtn.AbsoluteSize.Y / 2)
		end)

		tabBtn.MouseEnter:Connect(function()
			if activeTab ~= tabData then
				tw(tabBtn, CONFIG.ANIM_HOVER_GROW, {BackgroundColor3 = CONFIG.BG_HOVER, BackgroundTransparency = 0})
				tw(tabGlow, CONFIG.ANIM_SNAPPY, {BackgroundTransparency = 0.9})
			end
		end)

		tabBtn.MouseLeave:Connect(function()
			if activeTab ~= tabData then
				tw(tabBtn, CONFIG.ANIM_HOVER_SHRINK, {BackgroundColor3 = CONFIG.BG3, BackgroundTransparency = 0.15})
				tw(tabGlow, CONFIG.ANIM_SNAPPY, {BackgroundTransparency = 1})
			end
		end)

		if #allTabs == 1 then
			selectTab()
		end

		local function trackElement(frame: Instance, elementName: string?)
			table.insert(tabData._searchElements, {frame = frame, name = elementName or ""})
		end

		function tabData:CreateSection(title: string)
			local sec = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, sn(26)), Parent = page}) :: Frame
			mk("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				Position = UDim2.new(0, sn(4), 0, 0),
				Text = title,
				TextColor3 = CONFIG.TEXT_BRIGHT,
				Font = UI_FONT_SEMI,
				TextSize = sn(12),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = sec,
			})
			trackElement(sec, title)
			return sec
		end

		function tabData:CreateButton(elementCfg: {[string]: any}?)
			elementCfg = elementCfg or {}
			local wrapper, card, cs = buildCard(page, 38)
			local btn = mk("TextButton", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				Text = elementCfg.Name or "Button",
				TextColor3 = CONFIG.TEXT,
				Font = UI_FONT,
				TextSize = sn(12),
				TextXAlignment = Enum.TextXAlignment.Left,
				AutoButtonColor = false,
				Parent = card,
			}) :: TextButton
			applyPadding(btn, 0, sn(14), 0, sn(16))
			cardHover(card, cs)
			if elementCfg.Tooltip then attachTooltip(card, elementCfg.Tooltip) end
			btn.MouseButton1Click:Connect(function()
				rippleFx(btn, btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2)
				tw(cs, CONFIG.ANIM_QUICK, {Color = CONFIG.ACCENT, Transparency = 0})
				tw(card, CONFIG.ANIM_QUICK, {BackgroundColor3 = CONFIG.BG_CARD_ACTIVE})
				task.delay(0.25, function()
					tw(cs, CONFIG.ANIM_SMOOTH, {Color = CONFIG.BORDER_DIM, Transparency = 0.35})
					tw(card, CONFIG.ANIM_SMOOTH, {BackgroundColor3 = CONFIG.BG_CARD})
				end)
				if elementCfg.Callback then task.spawn(elementCfg.Callback) end
			end)
			trackElement(wrapper, elementCfg.Name or "Button")
			return wrapper
		end

		function tabData:CreateToggle(elementCfg: {[string]: any}?)
			elementCfg = elementCfg or {}
			local enabled = elementCfg.CurrentValue or false
			local togObj: {[string]: any} = {}
			local wrapper, card, cs = buildCard(page, isMobile and 44 or 38)
			local btn = mk("TextButton", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Text = "", AutoButtonColor = false, Parent = card}) :: TextButton
			mk("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, sn(14), 0, 0),
				Size = UDim2.new(1, -sn(88), 1, 0),
				Text = elementCfg.Name or "Toggle",
				TextColor3 = CONFIG.TEXT,
				Font = UI_FONT,
				TextSize = sn(12),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = btn,
			})

			local trackW, trackH, knobSize = snMobile(36), snMobile(18), snMobile(14)
			local track = mk("Frame", {
				BackgroundColor3 = enabled and CONFIG.TOGGLE_ON or CONFIG.TOGGLE_OFF,
				BackgroundTransparency = enabled and 0.5 or 0,
				Size = UDim2.new(0, trackW, 0, trackH),
				Position = UDim2.new(1, -sn(50), 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Parent = btn,
			}) :: Frame
			applyCorner(track, math.floor(trackH / 2))
			if enabled then gradientAccent(track, CONFIG.ACCENT, CONFIG.ACCENT_ALT, 90) end

			local knob = mk("Frame", {
				BackgroundColor3 = enabled and CONFIG.TOGGLE_KNOB or CONFIG.TOGGLE_KNOB_OFF,
				Size = UDim2.new(0, knobSize, 0, knobSize),
				Position = enabled and UDim2.new(1, -knobSize - 2, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Parent = track,
			}) :: Frame
			applyCorner(knob, math.floor(knobSize / 2))

			local function updateVisual()
				tw(track, CONFIG.ANIM_SMOOTH, {
					BackgroundColor3 = enabled and CONFIG.TOGGLE_ON or CONFIG.TOGGLE_OFF,
					BackgroundTransparency = enabled and 0.5 or 0,
				})
				tw(knob, CONFIG.ANIM_SMOOTH, {
					Position = enabled and UDim2.new(1, -knobSize - 2, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
					BackgroundColor3 = enabled and CONFIG.TOGGLE_KNOB or CONFIG.TOGGLE_KNOB_OFF,
				})
				tw(cs, CONFIG.ANIM_SMOOTH, {
					Color = enabled and CONFIG.BORDER_GLOW or CONFIG.BORDER_DIM,
					Transparency = enabled and 0.2 or 0.35,
				})
				for _, child in ipairs(track:GetChildren()) do
					if child:IsA("UIGradient") then child:Destroy() end
				end
				if enabled then gradientAccent(track, CONFIG.ACCENT, CONFIG.ACCENT_ALT, 90) end
			end

			btn.MouseButton1Click:Connect(function()
				enabled = not enabled
				updateVisual()
				if elementCfg.ConfigKey then setConfig(elementCfg.ConfigKey, enabled) end
				if elementCfg.Callback then task.spawn(elementCfg.Callback, enabled) end
			end)

			cardHover(card, cs)
			if elementCfg.Tooltip then attachTooltip(card, elementCfg.Tooltip) end

			if elementCfg.ConfigKey then
				registerConfig(elementCfg.ConfigKey, enabled, function(val)
					enabled = val
					updateVisual()
					if elementCfg.Callback then task.spawn(elementCfg.Callback, enabled) end
				end)
			end

			function togObj:Set(value: boolean)
				enabled = value
				updateVisual()
				if elementCfg.ConfigKey then setConfig(elementCfg.ConfigKey, enabled) end
				if elementCfg.Callback then task.spawn(elementCfg.Callback, enabled) end
			end

			trackElement(wrapper, elementCfg.Name or "Toggle")
			return togObj
		end

		function tabData:CreateSlider(elementCfg: {[string]: any}?)
			elementCfg = elementCfg or {}
			local minVal = elementCfg.Range and elementCfg.Range[1] or 0
			local maxVal = elementCfg.Range and elementCfg.Range[2] or 100
			local increment = math.max(elementCfg.Increment or 1, 0.001)
			local suffix = elementCfg.Suffix or ""
			local currentVal = math.clamp(elementCfg.CurrentValue or minVal, minVal, maxVal)
			local sliderObj: {[string]: any} = {}
			local wrapper, card, cs = buildCard(page, isMobile and 60 or 54)

			mk("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, sn(14), 0, sn(6)),
				Size = UDim2.new(0.6, -sn(14), 0, sn(18)),
				Text = elementCfg.Name or "Slider",
				TextColor3 = CONFIG.TEXT,
				Font = UI_FONT,
				TextSize = sn(12),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = card,
			})

			local valLbl = mk("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0.6, 0, 0, sn(6)),
				Size = UDim2.new(0.4, -sn(14), 0, sn(18)),
				Text = `{currentVal}{suffix}`,
				TextColor3 = CONFIG.TEXT_SUB,
				Font = UI_FONT,
				TextSize = sn(11),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = card,
			}) :: TextLabel

			local trackHeight, thumbSize = snMobile(8), snMobile(16)
			local trackBg = mk("Frame", {
				BackgroundColor3 = CONFIG.SLIDER_TRACK,
				Size = UDim2.new(1, -sn(28), 0, trackHeight),
				Position = UDim2.new(0, sn(14), 0, sn(34)),
				Parent = card,
			}) :: Frame
			applyCorner(trackBg, math.floor(trackHeight / 2))

			local initRatio = math.clamp((currentVal - minVal) / math.max(maxVal - minVal, 0.001), 0, 1)
			local fill = mk("Frame", {
				BackgroundColor3 = CONFIG.SLIDER_FILL,
				Size = UDim2.new(initRatio, 0, 1, 0),
				Parent = trackBg,
			}) :: Frame
			applyCorner(fill, math.floor(trackHeight / 2))
			gradientAccent(fill, CONFIG.ACCENT, CONFIG.ACCENT_ALT, 0)

			local thumb = mk("Frame", {
				BackgroundColor3 = CONFIG.SLIDER_THUMB,
				Size = UDim2.new(0, thumbSize, 0, thumbSize),
				Position = UDim2.new(initRatio, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 3,
				Parent = trackBg,
			}) :: Frame
			applyCorner(thumb, math.floor(thumbSize / 2))
			applyStroke(thumb, CONFIG.BORDER_GLOW, 1, 0.2)

			local sliding = false

			local function applySliderValue(inputX: number)
				local rel = math.clamp((inputX - trackBg.AbsolutePosition.X) / math.max(trackBg.AbsoluteSize.X, 1), 0, 1)
				local raw = minVal + (maxVal - minVal) * rel
				local stepped = math.floor(raw / increment + 0.5) * increment
				stepped = math.clamp(stepped, minVal, maxVal)
				if increment >= 1 then
					stepped = math.floor(stepped)
				else
					local d = math.max(0, -math.floor(math.log10(increment)))
					stepped = tonumber(string.format(`%.{d}f`, stepped)) or stepped
				end
				currentVal = stepped
				local ratio = (stepped - minVal) / math.max(maxVal - minVal, 0.001)
				tw(fill, CONFIG.ANIM_QUICK, {Size = UDim2.new(ratio, 0, 1, 0)})
				tw(thumb, CONFIG.ANIM_QUICK, {Position = UDim2.new(ratio, 0, 0.5, 0)})
				valLbl.Text = `{stepped}{suffix}`
				if elementCfg.ConfigKey then setConfig(elementCfg.ConfigKey, stepped) end
				if elementCfg.Callback then task.spawn(elementCfg.Callback, stepped) end
			end

			trackBg.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					applySliderValue(input.Position.X)
				end
			end)

			local sid = `sM_{tick()}_{math.random(1, 99999)}`
			addConnection(sid, UIS.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					applySliderValue(input.Position.X)
				end
			end))
			addConnection(`{sid}E`, UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end))

			cardHover(card, cs)
			if elementCfg.Tooltip then attachTooltip(card, elementCfg.Tooltip) end

			if elementCfg.ConfigKey then
				registerConfig(elementCfg.ConfigKey, currentVal, function(val)
					val = math.clamp(val, minVal, maxVal)
					currentVal = val
					local ratio = (val - minVal) / math.max(maxVal - minVal, 0.001)
					fill.Size = UDim2.new(ratio, 0, 1, 0)
					thumb.Position = UDim2.new(ratio, 0, 0.5, 0)
					valLbl.Text = `{val}{suffix}`
					if elementCfg.Callback then task.spawn(elementCfg.Callback, val) end
				end)
			end

			function sliderObj:Set(value: number)
				value = math.clamp(value, minVal, maxVal)
				currentVal = value
				local ratio = (value - minVal) / math.max(maxVal - minVal, 0.001)
				tw(fill, CONFIG.ANIM_QUICK, {Size = UDim2.new(ratio, 0, 1, 0)})
				tw(thumb, CONFIG.ANIM_QUICK, {Position = UDim2.new(ratio, 0, 0.5, 0)})
				valLbl.Text = `{value}{suffix}`
				if elementCfg.ConfigKey then setConfig(elementCfg.ConfigKey, value) end
				if elementCfg.Callback then task.spawn(elementCfg.Callback, value) end
			end

			trackElement(wrapper, elementCfg.Name or "Slider")
			return sliderObj
		end

		function tabData:CreateDropdown(elementCfg: {[string]: any}?)
			elementCfg = elementCfg or {}
			local options: {string} = elementCfg.Options or {}
			local multiSelect: boolean = elementCfg.MultiSelection or false
			local selected: {string} = elementCfg.CurrentOption or {}
			local isOpen = false
