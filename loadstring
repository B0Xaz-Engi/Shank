local function updateESP()
	espUpdateCounter += 1
	if espUpdateCounter % CONFIG.ESP_UPDATE_INTERVAL ~= 0 then return end
	local vp = camera.ViewportSize

	for player, data in pairs(espTags) do
		if not player or not player.Parent then
			removeESPTag(player)
			continue
		end
		if appState.espTeamFilter ~= "All" and not getESPColor(player) then
			removeESPTag(player)
			continue
		end

		local dist = getPlayerDistance(localPlayer, player)
		if dist and data.distLabel then
			data.distLabel.Text = `{dist}m`
			if dist < CONFIG.ESP_DIST_NEAR then
				data.distLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
			elseif dist < CONFIG.ESP_DIST_MID then
				data.distLabel.TextColor3 = Color3.fromRGB(255, 175, 40)
			else
				data.distLabel.TextColor3 = Color3.fromRGB(0, 255, 160)
			end
		end

		local hum = getHumanoid(player)
		if hum and data.healthLabel then
			local ratio = hum.Health / math.max(hum.MaxHealth, 1)
			data.healthLabel.Text = `{math.floor(hum.Health)}/{math.floor(hum.MaxHealth)}`
			if ratio > 0.7 then
				data.healthLabel.TextColor3 = Color3.fromRGB(0, 255, 160)
			elseif ratio > 0.3 then
				data.healthLabel.TextColor3 = Color3.fromRGB(255, 175, 40)
			else
				data.healthLabel.TextColor3 = Color3.fromRGB(255, 40, 40)
			end
		end

		local targetRoot = getRootPart(player)
		if targetRoot and data.tracerLine then
			local pos, onScreen = camera:WorldToScreenPoint(targetRoot.Position)
			if onScreen then
				data.tracerLine.From = Vector2.new(vp.X / 2, vp.Y)
				data.tracerLine.To = Vector2.new(pos.X, pos.Y)
				data.tracerLine.Visible = true
			else
				data.tracerLine.Visible = false
			end
		elseif data.tracerLine then
			data.tracerLine.Visible = false
		end

		if targetRoot and #(data.boxLines or {}) == 4 then
			local charHeight = 5
			local humObj = getHumanoid(player)
			if humObj then
				charHeight = humObj.HipHeight + 3
			end
			local topScreen, topOn = camera:WorldToScreenPoint(targetRoot.Position + Vector3.new(0, charHeight / 2, 0))
			local botScreen, botOn = camera:WorldToScreenPoint(targetRoot.Position - Vector3.new(0, charHeight / 2, 0))
			if topOn and botOn then
				local height = math.abs(botScreen.Y - topScreen.Y)
				local width = height * 0.6
				local cx, ty, by = topScreen.X, topScreen.Y, botScreen.Y
				data.boxLines[1].From = Vector2.new(cx - width / 2, ty)
				data.boxLines[1].To = Vector2.new(cx + width / 2, ty)
				data.boxLines[1].Visible = true
				data.boxLines[2].From = Vector2.new(cx + width / 2, ty)
				data.boxLines[2].To = Vector2.new(cx + width / 2, by)
				data.boxLines[2].Visible = true
				data.boxLines[3].From = Vector2.new(cx + width / 2, by)
				data.boxLines[3].To = Vector2.new(cx - width / 2, by)
				data.boxLines[3].Visible = true
				data.boxLines[4].From = Vector2.new(cx - width / 2, by)
				data.boxLines[4].To = Vector2.new(cx - width / 2, ty)
				data.boxLines[4].Visible = true
			else
				for _, l in ipairs(data.boxLines) do
					l.Visible = false
				end
			end
		end
	end
end

