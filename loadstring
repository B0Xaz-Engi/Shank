local function isInsideVendingModel(obj: Instance): boolean
	local cur = obj
	while cur and cur ~= workspace do
		if cur:IsA("Model") and cur.Name == "Model" and cur.Parent and cur.Parent.Name == "vending machine" then
			return true
		end
		cur = cur.Parent :: Instance
	end
	return false
end

local function shouldPhasePart(part: Instance?): boolean
	if not part or not part:IsA("BasePart") then return false end
	for _, folderName in ipairs(CONFIG.DOOR_FOLDERS) do
		local folder = workspace:FindFirstChild(folderName)
		if folder and part:IsDescendantOf(folder) then
			return true
		end
	end
	return isInsideVendingModel(part)
end

local function cachePhasePart(part: BasePart)
	if not shouldPhasePart(part) then return end
	if not savedDoorStates[part] then
		savedDoorStates[part] = {CanCollide = part.CanCollide, Transparency = part.Transparency}
	end
	phaseTargets[part] = true
end

local function rebuildPhaseTargets()
	table.clear(phaseTargets)
	for _, folderName in ipairs(CONFIG.DOOR_FOLDERS) do
		local folder = workspace:FindFirstChild(folderName)
		if folder then
			for _, obj in ipairs(folder:GetDescendants()) do
				if obj:IsA("BasePart") then
					cachePhasePart(obj)
				end
			end
		end
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and isInsideVendingModel(obj) then
			cachePhasePart(obj)
		end
	end
end

local function restoreDoorStates()
	for obj, props in pairs(savedDoorStates) do
		if obj and obj.Parent then
			obj.CanCollide = props.CanCollide
			obj.Transparency = props.Transparency
		end
	end
	savedDoorStates = {}
	table.clear(phaseTargets)
	removeConnection("DoorBypassWatcher")
end

local function processDoors()
	for part in pairs(phaseTargets) do
		if part and part.Parent then
			part.CanCollide = false
			part.Transparency = math.max(part.Transparency, 0.7)
		else
			phaseTargets[part] = nil
		end
	end
end

local function enableDoorBypass()
	savedDoorStates = {}
	rebuildPhaseTargets()
	processDoors()
	removeConnection("DoorBypassWatcher")
	addConnection("DoorBypassWatcher", workspace.DescendantAdded:Connect(function(obj)
		if not appState.doorBypass then return end
		if obj:IsA("BasePart") and shouldPhasePart(obj) then
			cachePhasePart(obj)
			obj.CanCollide = false
			obj.Transparency = math.max(obj.Transparency, 0.7)
		end
	end))
end

local function saveLighting()
	savedLighting = {
		Brightness = Lighting.Brightness,
		ClockTime = Lighting.ClockTime,
		FogEnd = Lighting.FogEnd,
		FogStart = Lighting.FogStart,
		GlobalShadows = Lighting.GlobalShadows,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
	}
	lightingEffects = {}
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Atmosphere") or child:IsA("ColorCorrectionEffect") or child:IsA("BloomEffect") or child:IsA("SunRaysEffect") or child:IsA("BlurEffect") then
			lightingEffects[child] = (child :: any).Enabled
		end
	end
end

local function enableFullbright()
	if not next(savedLighting) then
		saveLighting()
	end
	Lighting.Brightness = 3
	Lighting.ClockTime = 14
	Lighting.FogEnd = 1e6
	Lighting.FogStart = 1e6
	Lighting.GlobalShadows = false
	Lighting.Ambient = Color3.fromRGB(180, 180, 180)
	Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
	for child in pairs(lightingEffects) do
		if child and child.Parent then
