	local c = getCharacter(player)
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRootPart(player: Player?): BasePart?
	local c = getCharacter(player)
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function safeTeleport(cf: CFrame): boolean
	local root = getRootPart()
	if root then
		root.CFrame = cf
		return true
	end
	return false
end

local function getOtherPlayerNames(): {string}
	local names: {string} = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= localPlayer then
			table.insert(names, p.Name)
		end
	end
	return names
end

local function getPlayerDistance(p1: Player, p2: Player): number?
	local r1, r2 = getRootPart(p1), getRootPart(p2)
	if r1 and r2 then
		return math.floor((r1.Position - r2.Position).Magnitude)
	end
	return nil
end

local function isAlly(player: Player): boolean
	if not player or not localPlayer then return false end
	if player.Team and localPlayer.Team then
		return player.Team == localPlayer.Team
	end
	return false
end

local function getESPColor(player: Player): Color3?
	if appState.espTeamFilter == "Enemies" and isAlly(player) then return nil end
	if appState.espTeamFilter == "Allies" and not isAlly(player) then return nil end
	return isAlly(player) and CONFIG.ESP_ALLY_COLOR or CONFIG.ESP_ENEMY_COLOR
end

local function createESPTag(player: Player)
	if player == localPlayer or espTags[player] then return end
	local espColor = getESPColor(player)
	if not espColor and appState.espTeamFilter ~= "All" then return end
	espColor = espColor or appState.espColor

	local bb = mk("BillboardGui", {
		Name = `VoidESP_{player.Name}`,
		AlwaysOnTop = true,
		Size = CONFIG.ESP_BILLBOARD_SIZE,
		StudsOffset = CONFIG.ESP_BILLBOARD_OFFSET,
		ResetOnSpawn = false,
	}) :: BillboardGui

	local cont = mk("Frame", {
		BackgroundColor3 = Color3.fromRGB(5, 5, 15),
		BackgroundTransparency = 0.3,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = bb,
	}) :: Frame
	applyCorner(cont, 6)
	applyStroke(cont, espColor, 1, 0.4)
	applyLayout(cont, 1, nil, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	applyPadding(cont, 2, 0, 2, 0)

	mk("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -6, 0, 15),
		Text = player.DisplayName or player.Name,
		TextColor3 = espColor,
		TextStrokeTransparency = 0.2,
		TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
		Font = UI_FONT,
		TextSize = 12,
		Parent = cont,
	})

	local distL = mk("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -6, 0, 13),
		Text = "? m",
		TextColor3 = CONFIG.TEXT_SUB,
		Font = UI_FONT,
		TextSize = 10,
		Parent = cont,
	}) :: TextLabel

	local hpL = mk("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -6, 0, 13),
		Text = "? HP",
		TextColor3 = CONFIG.NOTIF_SUCCESS,
		Font = UI_FONT,
		TextSize = 10,
		Parent = cont,
	}) :: TextLabel

	local data = {
		billboard = bb,
		distLabel = distL,
		healthLabel = hpL,
		connections = {} :: {RBXScriptConnection},
		tracerLine = nil :: any,
		boxLines = {} :: {any},
	}

	local function attachBB(char: Model?)
		if not char then return end
		local head = char:FindFirstChild("Head")
		if not head then
			pcall(function()
				head = char:WaitForChild("Head", 5)
			end)
		end
		if head then
			bb.Adornee = head
			bb.Parent = CoreGui
		end
	end

	if player.Character then
		attachBB(player.Character)
	end
	table.insert(data.connections, player.CharacterAdded:Connect(attachBB))

	if hasDrawing and appState.espTracers then
		local line = Drawing.new("Line")
		line.Color = espColor
		line.Thickness = CONFIG.ESP_TRACER_THICKNESS
		line.Transparency = 1 - CONFIG.ESP_TRACER_TRANSPARENCY
		line.Visible = true
		data.tracerLine = line
		drawingObjects[`tracer_{player.Name}`] = line
	end

	if hasDrawing and appState.espBoxes then
		local boxLines = {}
		for i = 1, 4 do
			local l = Drawing.new("Line")
			l.Color = espColor
			l.Thickness = CONFIG.ESP_BOX_THICKNESS
			l.Transparency = 1 - CONFIG.ESP_BOX_TRANSPARENCY
			l.Visible = true
			table.insert(boxLines, l)
			drawingObjects[`box_{player.Name}_{i}`] = l
		end
		data.boxLines = boxLines
	end

