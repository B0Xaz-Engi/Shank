	local function checkKey()
		local now = tick()
		if keyAttempts >= CONFIG.KEY_MAX_ATTEMPTS and (now - keyLastAttempt) < CONFIG.KEY_COOLDOWN then
			statusLbl.TextColor3 = CONFIG.NOTIF_WARNING
			statusLbl.Text = "Too many attempts"
			return
		end
		local key = inputBox.Text:match("^%s*(.-)%s*$")
		keyLastAttempt = now

		if key == CONFIG.KEY then
			keyCorrect = true
			statusLbl.TextColor3 = CONFIG.NOTIF_SUCCESS
			statusLbl.Text = "Access granted"
			tw(submitBtn, CONFIG.ANIM_QUICK, {BackgroundColor3 = Color3.fromRGB(45, 125, 88)})
