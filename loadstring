		end
	end
end

local function disableFullbright()
	if next(savedLighting) then
		for k, v in pairs(savedLighting) do
			pcall(function()
				(Lighting :: any)[k] = v
			end)
		end
	end
	for child, wasEnabled in pairs(lightingEffects) do
		if child and child.Parent then
			(child :: any).Enabled = wasEnabled
		end
	end
end

local function enableFreecam()
	freecamOldSubject = camera.CameraSubject
	camera.CameraType = Enum.CameraType.Scriptable
	local hum = getHumanoid()
	if hum then
		hum.WalkSpeed = 0
	end
	local cf = camera.CFrame
	local yaw = math.atan2(-cf.LookVector.X, -cf.LookVector.Z)
	local pitch = math.asin(math.clamp(cf.LookVector.Y, -1, 1))

	addConnection("FreecamUpdate", RunService.RenderStepped:Connect(function(dt: number)
		if not appState.freecam then return end
		local mouseDelta = UIS:GetMouseDelta()
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			yaw -= mouseDelta.X * 0.003
			pitch = math.clamp(pitch - mouseDelta.Y * 0.003, -math.pi / 2 + 0.1, math.pi / 2 - 0.1)
		end
		local lookDir = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
		local speed = CONFIG.FREECAM_SPEED * dt
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
			speed *= CONFIG.FREECAM_FAST_MULT
		end
		local moveDir = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir += lookDir.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir -= lookDir.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir -= lookDir.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir += lookDir.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.E) then moveDir += Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.Q) then moveDir -= Vector3.yAxis end
		local newPos = camera.CFrame.Position
		if moveDir.Magnitude > 0 then
			newPos += moveDir.Unit * speed
		end
		camera.CFrame = CFrame.new(newPos) * lookDir
	end))
end

local function disableFreecam()
	removeConnection("FreecamUpdate")
	camera.CameraType = Enum.CameraType.Custom
	if freecamOldSubject then
		camera.CameraSubject = freecamOldSubject
	end
	freecamOldSubject = nil
	local hum = getHumanoid()
	if hum then
		hum.WalkSpeed = appState.customWalkspeed
	end
end

