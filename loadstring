			local arrow = mk("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(1, -sn(24), 0, 0),
				Size = UDim2.new(0, sn(18), 1, 0),
				Text = "v",
				TextColor3 = CONFIG.TEXT_MUTED,
				Font = UI_FONT_BOLD,
				TextSize = sn(11),
				Parent = header,
			}) :: TextLabel

			local optContainer = mk("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 0, 0, sn(40)),
				Size = UDim2.new(1, 0, 0, 0),
				ClipsDescendants = true,
				Parent = card,
			}) :: Frame
			applyLayout(optContainer, sn(3))
			applyPadding(optContainer, sn(2), sn(8), sn(8), sn(8))

			local optionButtons: {Instance} = {}

			local function updateDisplay()
				selLbl.Text = #selected > 0 and table.concat(selected, ", ") or "None"
			end

			local function buildOptions()
				for _, ob in ipairs(optionButtons) do ob:Destroy() end
				optionButtons = {}
				for _, opt in ipairs(options) do
					local isSel = table.find(selected, opt) ~= nil
					local ob = mk("TextButton", {
						BackgroundColor3 = isSel and CONFIG.DROPDOWN_ACTIVE or CONFIG.DROPDOWN_BG,
						Size = UDim2.new(1, 0, 0, sn(28)),
						Text = opt,
						TextColor3 = isSel and CONFIG.TEXT_BRIGHT or CONFIG.TEXT_SUB,
						Font = UI_FONT,
						TextSize = sn(11),
						TextXAlignment = Enum.TextXAlignment.Left,
						AutoButtonColor = false,
						Parent = optContainer,
					}) :: TextButton
					applyCorner(ob, sn(6))
					applyPadding(ob, 0, sn(10), 0, sn(12))
					ob.MouseEnter:Connect(function() tw(ob, CONFIG.ANIM_HOVER_GROW, {BackgroundColor3 = CONFIG.DROPDOWN_HOVER}) end)
					ob.MouseLeave:Connect(function() tw(ob, CONFIG.ANIM_HOVER_SHRINK, {BackgroundColor3 = table.find(selected, opt) and CONFIG.DROPDOWN_ACTIVE or CONFIG.DROPDOWN_BG}) end)
					ob.MouseButton1Click:Connect(function()
						if multiSelect then
							local idx = table.find(selected, opt)
							if idx then
								table.remove(selected, idx)
							else
								table.insert(selected, opt)
							end
						else
							selected = {opt}
						end
						updateDisplay()
						buildOptions()
						if not multiSelect then
							isOpen = false
							tw(card, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(card.Size.X.Scale, card.Size.X.Offset, 0, sn(38))})
							tw(wrapper, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(1, 0, 0, sn(44))})
							arrow.Text = "v"
						end
						if elementCfg.Callback then task.spawn(elementCfg.Callback, selected) end
					end)
					table.insert(optionButtons, ob)
				end
			end

			buildOptions()

			header.MouseButton1Click:Connect(function()
				isOpen = not isOpen
				if isOpen then
					local oH = #options * sn(31) + sn(14)
					tw(card, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(card.Size.X.Scale, card.Size.X.Offset, 0, sn(38) + oH)})
					tw(wrapper, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(1, 0, 0, sn(44) + oH)})
					optContainer.Size = UDim2.new(1, 0, 0, oH)
					arrow.Text = "^"
					tw(cs, CONFIG.ANIM_QUICK, {Color = CONFIG.BORDER_GLOW, Transparency = 0.15})
				else
					tw(card, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(card.Size.X.Scale, card.Size.X.Offset, 0, sn(38))})
					tw(wrapper, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(1, 0, 0, sn(44))})
					arrow.Text = "v"
					tw(cs, CONFIG.ANIM_SMOOTH, {Color = CONFIG.BORDER_DIM, Transparency = 0.35})
				end
			end)

			cardHover(card, cs)
			if elementCfg.Tooltip then attachTooltip(card, elementCfg.Tooltip) end

			function dropObj:Set(newOptions: {string}?)
				options = newOptions or {}
				selected = {}
				updateDisplay()
				buildOptions()
				if isOpen then
					isOpen = false
					tw(card, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(card.Size.X.Scale, card.Size.X.Offset, 0, sn(38))})
					tw(wrapper, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(1, 0, 0, sn(44))})
					arrow.Text = "v"
				end
			end

			function dropObj:SetSelected(sel: any)
				selected = type(sel) == "string" and {sel} or (sel or {})
				updateDisplay()
				buildOptions()
			end

			trackElement(wrapper, elementCfg.Name or "Dropdown")
			return dropObj
		end

