local function setupChatCommands()
	addConnection("ChatCommands", localPlayer.Chatted:Connect(function(msg: string)
		local args: {string} = {}
		for word in msg:gmatch("%S+") do
			table.insert(args, word)
		end
		local cmd = args[1] and args[1]:lower() or ""

		if cmd == "/speed" then
			local val = tonumber(args[2])
			if val then
				appState.customWalkspeed = math.clamp(val, 16, 100)
				local hum = getHumanoid()
				if hum then
					hum.WalkSpeed = appState.customWalkspeed
				end
				VoidUI:Notify({Title = "Void", Content = `Speed set to {val}`, Duration = 2, Type = "Success"})
			end

		elseif cmd == "/jp" or cmd == "/jumppower" then
			local val = tonumber(args[2])
			if val then
				local hum = getHumanoid()
				if hum then
					hum.JumpPower = math.clamp(val, 50, 200)
					hum.UseJumpPower = true
				end
				VoidUI:Notify({Title = "Void", Content = `Jump power set to {val}`, Duration = 2, Type = "Success"})
			end

		elseif cmd == "/tp" then
			local targetName = args[2]
			if targetName then
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Name:lower():find(targetName:lower(), 1, true) then
						local r = getRootPart(p)
						if r then
							safeTeleport(r.CFrame * CFrame.new(0, 0, 5))
							VoidUI:Notify({Title = "Void", Content = `Warped to {p.Name}`, Duration = 2, Type = "Success"})
						end
						break
					end
				end
			end

		elseif cmd == "/esp" then
			appState.espEnabled = not appState.espEnabled
			if appState.espEnabled then
				for _, p in ipairs(Players:GetPlayers()) do
					createESPTag(p)
				end
			else
				clearAllESP()
			end
			VoidUI:Notify({Title = "Void", Content = appState.espEnabled and "ESP on" or "ESP off", Duration = 2, Type = "Info"})

		elseif cmd == "/chams" then
			appState.chamsEnabled = not appState.chamsEnabled
			if appState.chamsEnabled then
				ensureChamsFolder()
				for _, p in ipairs(Players:GetPlayers()) do
					addChams(p)
				end
			else
				clearAllChams()
			end
			VoidUI:Notify({Title = "Void", Content = appState.chamsEnabled and "Chams on" or "Chams off", Duration = 2, Type = "Info"})

		elseif cmd == "/fullbright" or cmd == "/fb" then
			appState.fullbright = not appState.fullbright
			if appState.fullbright then
				enableFullbright()
			else
				disableFullbright()
			end
			VoidUI:Notify({Title = "Void", Content = appState.fullbright and "Fullbright on" or "Fullbright off", Duration = 2, Type = "Info"})

		elseif cmd == "/god" then
			appState.godMode = not appState.godMode
			VoidUI:Notify({Title = "Void", Content = appState.godMode and "God mode on" or "God mode off", Duration = 2, Type = "Info"})

		elseif cmd == "/infjump" or cmd == "/ij" then
			appState.infJump = not appState.infJump
			VoidUI:Notify({Title = "Void", Content = appState.infJump and "Inf jump on" or "Inf jump off", Duration = 2, Type = "Info"})

		elseif cmd == "/noclip" then
			appState.doorBypass = not appState.doorBypass
			if appState.doorBypass then
				enableDoorBypass()
			else
				restoreDoorStates()
			end
			VoidUI:Notify({Title = "Void", Content = appState.doorBypass and "Door bypass on" or "Door bypass off", Duration = 2, Type = "Info"})

		elseif cmd == "/fov" then
			local val = tonumber(args[2])
			if val then
				appState.customFOV = math.clamp(val, 30, 120)
				camera.FieldOfView = appState.customFOV
				VoidUI:Notify({Title = "Void", Content = `FOV set to {val}`, Duration = 2, Type = "Success"})
			end

		elseif cmd == "/save" then
			local name = args[2] or "default"
			if saveWaypoint(name) then
				VoidUI:Notify({Title = "Void", Content = `Saved waypoint: {name}`, Duration = 2, Type = "Success"})
			end

		elseif cmd == "/goto" then
			local name = args[2] or "default"
			if teleportWaypoint(name) then
				VoidUI:Notify({Title = "Void", Content = `Warped to: {name}`, Duration = 2, Type = "Success"})
			else
				VoidUI:Notify({Title = "Void", Content = "Waypoint not found", Duration = 2, Type = "Error"})
			end

		elseif cmd == "/delwp" then
			local name = args[2] or "default"
			deleteWaypoint(name)
			VoidUI:Notify({Title = "Void", Content = `Deleted waypoint: {name}`, Duration = 2, Type = "Info"})

		elseif cmd == "/rejoin" then
			TeleportService:Teleport(game.PlaceId, localPlayer)

		elseif cmd == "/inventory" or cmd == "/inv" then
			local targetName = args[2]
			if targetName then
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Name:lower():find(targetName:lower(), 1, true) then
						local result = viewInventory(p.Name)
						VoidUI:Notify({Title = `{p.Name} inventory`, Content = result, Duration = 5, Type = "Info"})
						break
					end
				end
			else
				VoidUI:Notify({Title = "Void", Content = "Usage: /inv playername", Duration = 2, Type = "Warning"})
			end

		elseif cmd == "/orbit" then
			appState.orbit = not appState.orbit
			if appState.orbit then
				if appState.selectedPlayer then
					startOrbit()
					VoidUI:Notify({Title = "Void", Content = `Orbiting {appState.selectedPlayer}`, Duration = 2, Type = "Success"})
				else
					appState.orbit = false
					VoidUI:Notify({Title = "Void", Content = "Select a target first", Duration = 2, Type = "Error"})
				end
			else
				stopOrbit()
				VoidUI:Notify({Title = "Void", Content = "Orbit off", Duration = 2, Type = "Info"})
			end

		elseif cmd == "/cmds" or cmd == "/help" then
			VoidUI:Notify({Title = "Commands", Content = "/speed /jp /tp /esp /chams /fb /god /ij /noclip /fov /save /goto /delwp /rejoin /inv /orbit", Duration = 8, Type = "Info"})
		end
	end))
end

