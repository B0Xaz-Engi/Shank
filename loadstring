local function rippleFx(button: GuiObject, inputX: number, inputY: number)
	local fx = mk("Frame", {
		BackgroundColor3 = CONFIG.ACCENT_LIGHT,
		BackgroundTransparency = 0.7,
		Position = UDim2.new(0, inputX - button.AbsolutePosition.X, 0, inputY - button.AbsolutePosition.Y),
		Size = UDim2.new(0, 0, 0, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 50,
		Parent = button,
	}) :: Frame
	applyCorner(fx, 999)
	button.ClipsDescendants = true
	local maxS = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.5
	local t = tw(fx, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {
		Size = UDim2.new(0, maxS, 0, maxS),
		BackgroundTransparency = 1,
	})
	t.Completed:Once(function()
		fx:Destroy()
	end)
end

local function fadeOutAndDestroy(frame: Instance, duration: number?)
	local dur = duration or 0.3
	local info = TweenInfo.new(dur, Enum.EasingStyle.Quint)
	tw(frame, info, {BackgroundTransparency = 1})
	for _, child in ipairs(frame:GetDescendants()) do
		pcall(function()
			if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") then
				tw(child, CONFIG.ANIM_QUICK, {TextTransparency = 1})
			elseif child:IsA("Frame") or child:IsA("ScrollingFrame") then
				tw(child, CONFIG.ANIM_QUICK, {BackgroundTransparency = 1})
			elseif child:IsA("UIStroke") then
				tw(child, CONFIG.ANIM_QUICK, {Transparency = 1})
			elseif child:IsA("ImageLabel") then
				tw(child, CONFIG.ANIM_QUICK, {ImageTransparency = 1})
			end
		end)
	end
	task.delay(dur, function()
		if frame and frame.Parent then
			frame:Destroy()
		end
	end)
end

local function makeDragHandler(target: GuiObject, handle: GuiObject)
	local dragging = false
	local dragStart: Vector3? = nil
	local startPos: UDim2? = nil

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position
		end
	end)

	addConnection(`drag_move_{target.Name}`, UIS.InputChanged:Connect(function(input)
		if not dragging or not dragStart or not startPos then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			tw(target, TweenInfo.new(0.08, Enum.EasingStyle.Quint), {
				Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y),
			})
		end
	end))

	addConnection(`drag_end_{target.Name}`, UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			dragStart = nil
			startPos = nil
		end
	end))
end

local function playNotifSound()
	pcall(function()
		local sound = Instance.new("Sound")
		sound.SoundId = CONFIG.NOTIF_SOUND_ID
		sound.Volume = CONFIG.NOTIF_SOUND_VOLUME
		sound.PlaybackSpeed = CONFIG.NOTIF_SOUND_PITCH_MIN + math.random() * (CONFIG.NOTIF_SOUND_PITCH_MAX - CONFIG.NOTIF_SOUND_PITCH_MIN)
		sound.Parent = SoundService
		sound:Play()
		sound.Ended:Once(function()
			sound:Destroy()
		end)
		task.delay(3, function()
			if sound and sound.Parent then
				sound:Destroy()
			end
		end)
	end)
end

local configData: {[string]: any} = {}
local configCallbacks: {[string]: (any) -> ()} = {}

local function ensureConfigFolder(): boolean
	if not hasFilesystem then return false end
	pcall(function()
		if not isfolder(CONFIG.CONFIG_FOLDER) then
			makefolder(CONFIG.CONFIG_FOLDER)
		end
	end)
	return true
end

local function saveConfig()
	if not hasFilesystem then return end
	ensureConfigFolder()
	pcall(function()
		writefile(CONFIG.CONFIG_FILE, HttpService:JSONEncode(configData))
	end)
end

local function loadConfig()
	if not hasFilesystem then return end
	pcall(function()
		if isfile(CONFIG.CONFIG_FILE) then
			local raw = readfile(CONFIG.CONFIG_FILE)
			local parsed = HttpService:JSONDecode(raw)
			if type(parsed) == "table" then
				configData = parsed
			end
		end
	end)
end

local function registerConfig(key: string, defaultVal: any, callback: (any) -> ())
	configCallbacks[key] = callback
	if configData[key] == nil then
		configData[key] = defaultVal
	end
end

local function setConfig(key: string, value: any)
	configData[key] = value
	saveConfig()
end

local function getConfig(key: string, default: any): any
	if configData[key] ~= nil then
		return configData[key]
	end
	return default
end

local function applyLoadedConfigs()
	for key, callback in pairs(configCallbacks) do
		if configData[key] ~= nil then
			pcall(callback, configData[key])
		end
	end
end

