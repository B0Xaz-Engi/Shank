local function mk(class, props)
	local obj = Instance.new(class)
	for k, v in pairs(props) do if k ~= "Parent" and k ~= "Children" then obj[k] = v end end
	if props.Children then for _, child in ipairs(props.Children) do child.Parent = obj end end
	if props.Parent then obj.Parent = props.Parent end
	return obj
end

