		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		ZIndex = 101,
		Parent = tooltipFrame,
	}) :: TextLabel
end

local function showTooltip(text: string?, absX: number, absY: number)
	if not tooltipFrame or not text or text == "" then
		if tooltipFrame then
			tooltipFrame.Visible = false
		end
		return
	end
	tooltipLabel.Text = text
	local textWidth = math.min(260, #text * 6 + 24)
	local lines = math.ceil(#text / 40)
	local textHeight = math.max(28, lines * 15 + 10)
	tooltipFrame.Size = UDim2.new(0, textWidth, 0, textHeight)
	tooltipFrame.Position = UDim2.new(0, absX + 14, 0, absY - textHeight - 6)
	tooltipFrame.Visible = true
end

local function hideTooltip()
	if tooltipFrame then
		tooltipFrame.Visible = false
	end
end

local function attachTooltip(element: GuiObject, text: string?)
	if not text or text == "" then return end
	element.MouseEnter:Connect(function()
		local pos = element.AbsolutePosition
		showTooltip(text, pos.X + element.AbsoluteSize.X / 2, pos.Y)
	end)
	element.MouseLeave:Connect(hideTooltip)
end

