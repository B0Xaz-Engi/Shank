			task.delay(0.6, function()
				fadeOutAndDestroy(kFrame, 0.2)
				task.delay(0.3, function()
					if kGui and kGui.Parent then
						kGui:Destroy()
					end
				end)
			end)
		else
			keyAttempts += 1
			local remaining = CONFIG.KEY_MAX_ATTEMPTS - keyAttempts
			statusLbl.TextColor3 = CONFIG.NOTIF_ERROR
			statusLbl.Text = remaining > 0 and `Invalid key ({remaining} left)` or "Locked out"
			inputBox.Text = ""
			tw(iStroke, CONFIG.ANIM_QUICK, {Color = CONFIG.NOTIF_ERROR})
			tw(kStroke, CONFIG.ANIM_QUICK, {Color = CONFIG.NOTIF_ERROR})
			task.delay(0.45, function()
				tw(iStroke, CONFIG.ANIM_SNAPPY, {Color = CONFIG.BORDER_DIM})
				tw(kStroke, CONFIG.ANIM_SNAPPY, {Color = CONFIG.BORDER})
			end)
		end
	end

	submitBtn.MouseButton1Click:Connect(checkKey)
	inputBox.FocusLost:Connect(function(enter)
		if enter then
			checkKey()
		end
	end)
end

createKeyUI()
repeat task.wait(0.1) until keyCorrect

function VoidUI:CreateWindow(cfg: {[string]: any}?)
