local function getScale(): number
	local vp = camera.ViewportSize
	if isMobile then
		return math.clamp(
			math.min(vp.X / CONFIG.SCALE_MOBILE_REF_X, vp.Y / CONFIG.SCALE_MOBILE_REF_Y),
			CONFIG.SCALE_MOBILE_MIN,
			CONFIG.SCALE_MOBILE_MAX
		)
	end
	return math.clamp(
		math.min(vp.X / CONFIG.SCALE_PC_REF_X, vp.Y / CONFIG.SCALE_PC_REF_Y),
		CONFIG.SCALE_PC_MIN,
		CONFIG.SCALE_PC_MAX
	)
end

local function sn(n: number): number
	return math.floor(n * getScale())
end

local function snMobile(n: number): number
	if isMobile then
		return math.floor(n * getScale() * CONFIG.WINDOW_MOBILE_TOUCH_SCALE)
	end
	return sn(n)
end

local function mk(class: string, props: {[string]: any}): Instance
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Children" then
			(obj :: any)[k] = v
		end
	end
	if props.Children then
		for _, child in ipairs(props.Children) do
			child.Parent = obj
		end
	end
	if props.Parent then
		obj.Parent = props.Parent
	end
	return obj
end

