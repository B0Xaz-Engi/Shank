		function tabData:CreateColorPicker(elementCfg: {[string]: any}?)
			elementCfg = elementCfg or {}
			local currentColor = elementCfg.Default or Color3.fromRGB(0, 255, 200)
			local cpObj: {[string]: any} = {}
			local wrapper, card, cs = buildCard(page, 38)
			card.ClipsDescendants = true

			local header = mk("TextButton", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, sn(38)), Text = "", AutoButtonColor = false, Parent = card}) :: TextButton
			mk("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, sn(14), 0, 0),
				Size = UDim2.new(0.6, -sn(14), 1, 0),
				Text = elementCfg.Name or "Color",
				TextColor3 = CONFIG.TEXT,
				Font = UI_FONT,
				TextSize = sn(12),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = header,
			})
			local preview = mk("Frame", {
				BackgroundColor3 = currentColor,
				Size = UDim2.new(0, sn(22), 0, sn(22)),
				Position = UDim2.new(1, -sn(34), 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Parent = header,
			}) :: Frame
			applyCorner(preview, sn(6))
			applyStroke(preview, CONFIG.BORDER, 1, 0.15)

			local pickerOpen = false
			local pickerFrame = mk("Frame", {
				BackgroundColor3 = CONFIG.COLOR_PICKER_BG,
				Size = UDim2.new(1, -sn(20), 0, sn(120)),
				Position = UDim2.new(0, sn(10), 0, sn(42)),
				Visible = false,
				Parent = card,
			}) :: Frame
			applyCorner(pickerFrame, sn(6))
			applyStroke(pickerFrame, CONFIG.BORDER_DIM, 1, 0.3)
			applyPadding(pickerFrame, sn(8), sn(10), sn(8), sn(10))

			local r, g, b = math.floor(currentColor.R * 255), math.floor(currentColor.G * 255), math.floor(currentColor.B * 255)
			local sliderData: {any} = {}
			local cpSliding: any = nil

			local function updateColorFromSliders()
				currentColor = Color3.fromRGB(r, g, b)
				preview.BackgroundColor3 = currentColor
				for _, sd in ipairs(sliderData) do
					sd.fill.Size = UDim2.new(sd.getVal() / 255, 0, 1, 0)
					sd.lbl.Text = tostring(sd.getVal())
				end
				if elementCfg.ConfigKey then setConfig(elementCfg.ConfigKey, {r, g, b}) end
				if elementCfg.Callback then task.spawn(elementCfg.Callback, currentColor) end
			end

			local channelInfo = {
				{"R", function() return r end, function(v: number) r = v end},
				{"G", function() return g end, function(v: number) g = v end},
				{"B", function() return b end, function(v: number) b = v end},
			}

			for i, info in ipairs(channelInfo) do
				local yPos = sn(6) + (i - 1) * sn(30)
				mk("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(0, sn(16), 0, sn(14)),
					Position = UDim2.new(0, sn(6), 0, yPos),
					Text = info[1],
					TextColor3 = CONFIG.TEXT_SUB,
					Font = UI_FONT,
					TextSize = sn(10),
					Parent = pickerFrame,
				})
				local slBg = mk("Frame", {
					BackgroundColor3 = CONFIG.SLIDER_TRACK,
					Size = UDim2.new(1, -sn(58), 0, sn(8)),
					Position = UDim2.new(0, sn(28), 0, yPos + sn(3)),
					Parent = pickerFrame,
				}) :: Frame
				applyCorner(slBg, sn(4))
				local slFill = mk("Frame", {
					BackgroundColor3 = CONFIG.ACCENT,
					Size = UDim2.new(info[2]() / 255, 0, 1, 0),
					Parent = slBg,
				}) :: Frame
				applyCorner(slFill, sn(4))
				local slVal = mk("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(0, sn(26), 0, sn(14)),
					Position = UDim2.new(1, sn(4), 0, yPos),
					Text = tostring(info[2]()),
					TextColor3 = CONFIG.TEXT,
					Font = UI_FONT,
					TextSize = sn(9),
					Parent = pickerFrame,
				}) :: TextLabel

				local slider = {bg = slBg, fill = slFill, lbl = slVal, getVal = info[2], setVal = info[3]}
				table.insert(sliderData, slider)

				slBg.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						cpSliding = slider
						local rel = math.clamp((input.Position.X - slBg.AbsolutePosition.X) / math.max(slBg.AbsoluteSize.X, 1), 0, 1)
						info[3](math.floor(rel * 255))
						updateColorFromSliders()
					end
				end)
			end

			local cpId = `cpM_{tick()}_{math.random(1, 99999)}`
			addConnection(cpId, UIS.InputChanged:Connect(function(input)
				if cpSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local rel = math.clamp((input.Position.X - cpSliding.bg.AbsolutePosition.X) / math.max(cpSliding.bg.AbsoluteSize.X, 1), 0, 1)
					cpSliding.setVal(math.floor(rel * 255))
					updateColorFromSliders()
				end
			end))
			addConnection(`{cpId}E`, UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					cpSliding = nil
				end
			end))

			header.MouseButton1Click:Connect(function()
				pickerOpen = not pickerOpen
				pickerFrame.Visible = pickerOpen
				local newH = pickerOpen and sn(175) or sn(38)
				tw(card, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(card.Size.X.Scale, card.Size.X.Offset, 0, newH)})
				tw(wrapper, CONFIG.ANIM_SMOOTH, {Size = UDim2.new(1, 0, 0, newH + sn(6))})
			end)

			cardHover(card, cs)
			if elementCfg.Tooltip then attachTooltip(card, elementCfg.Tooltip) end

			if elementCfg.ConfigKey then
				registerConfig(elementCfg.ConfigKey, {r, g, b}, function(val)
					if type(val) == "table" and #val >= 3 then
						r = math.clamp(val[1], 0, 255)
						g = math.clamp(val[2], 0, 255)
						b = math.clamp(val[3], 0, 255)
						updateColorFromSliders()
					end
				end)
			end

			function cpObj:Set(color: Color3)
				r = math.floor(color.R * 255)
				g = math.floor(color.G * 255)
				b = math.floor(color.B * 255)
				updateColorFromSliders()
			end

			function cpObj:Get(): Color3
				return currentColor
			end

			trackElement(wrapper, elementCfg.Name or "Color")
			return cpObj
		end

		return tabData
	end

	return winObj
end

