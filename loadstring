local function fadeOutAndDestroy(frame, duration)
	local info = TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quint)
	tw(frame, info, {BackgroundTransparency = 1})
	for _, child in ipairs(frame:GetDescendants()) do pcall(function()
		if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") then tw(child, A.QUICK, {TextTransparency = 1})
		elseif child:IsA("Frame") or child:IsA("ScrollingFrame") then tw(child, A.QUICK, {BackgroundTransparency = 1})
		elseif child:IsA("UIStroke") then tw(child, A.QUICK, {Transparency = 1})
		elseif child:IsA("ImageLabel") then tw(child, A.QUICK, {ImageTransparency = 1}) end
	end) end
	task.delay(duration or 0.3, function() if frame and frame.Parent then frame:Destroy() end end)
end

local function makeDragHandler(target, handle)
	local dragging, dragStart, startPos = false, nil, nil
	handle.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragStart = input.Position; startPos = target.Position end end)
	addConnection("drag_move_" .. target.Name, UserInputService.InputChanged:Connect(function(input) if not dragging or not dragStart or not startPos then return end; if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then local delta = input.Position - dragStart; tw(target, TweenInfo.new(0.08, Enum.EasingStyle.Quint), {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}) end end))
	addConnection("drag_end_" .. target.Name, UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false; dragStart = nil; startPos = nil end end))
end

