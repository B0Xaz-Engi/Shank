local function viewInventory(playerName: string): string
	local target = Players:FindFirstChild(playerName)
	if not target then return "Player not found" end
	local bp = target:FindFirstChild("Backpack")
	local char = getCharacter(target :: Player)
	local tools: {string} = {}
	if bp then
		for _, item in ipairs(bp:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(tools, item.Name)
			end
		end
	end
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(tools, `{item.Name} (held)`)
			end
		end
	end
	if #tools == 0 then return "No tools found" end
	return table.concat(tools, ", ")
end

local function startOrbit()
	addConnection("OrbitLoop", RunService.Heartbeat:Connect(function()
		if not appState.orbit or not appState.selectedPlayer then return end
		local target = Players:FindFirstChild(appState.selectedPlayer)
		local tr = target and getRootPart(target :: Player)
		local mr = getRootPart()
		if not tr or not mr then return end
		local t = tick() * appState.orbitSpeed
		local offset = Vector3.new(math.cos(t) * appState.orbitRadius, 0, math.sin(t) * appState.orbitRadius)
		mr.CFrame = CFrame.new(tr.Position + offset, tr.Position)
	end))
end

local function stopOrbit()
	removeConnection("OrbitLoop")
end

local function saveWaypoint(name: string): boolean
	local r = getRootPart()
