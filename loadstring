	-- Main heartbeat loop
	addConnection("MainLoop", RunService.Heartbeat:Connect(function()
		local char = getCharacter()
		if not char then return end
		local humanoid = getHumanoid()

		if humanoid then
			if not appState.freecam then
				if appState.customWalkspeed > CONFIG.DEFAULT_WALKSPEED then
					if humanoid.WalkSpeed < appState.customWalkspeed then
						humanoid.WalkSpeed = appState.customWalkspeed
					end
				elseif appState.antiRestrict then
					if humanoid.WalkSpeed < CONFIG.DEFAULT_WALKSPEED then
						humanoid.WalkSpeed = CONFIG.DEFAULT_WALKSPEED
					end
				end
			end
			if appState.antiRestrict and humanoid.JumpPower < CONFIG.DEFAULT_JUMPPOWER then
				humanoid.JumpPower = CONFIG.DEFAULT_JUMPPOWER
			end
			if appState.godMode then
				humanoid.Health = humanoid.MaxHealth
			end
		end

		if appState.antiRestrict then
			local pGui = localPlayer:FindFirstChild("PlayerGui")
			if pGui then
				for _, guiName in ipairs({"Taser", "Flashbang", "Cuffs"}) do
					local restrictGui = pGui:FindFirstChild(guiName)
					if restrictGui and (restrictGui :: any).Enabled then
						(restrictGui :: any).Enabled = false
					end
				end
			end
		end

		if appState.doorBypass then processDoors() end
		if appState.espEnabled then updateESP() end
		if appState.fullbright then enableFullbright() end
		if appState.noFog then
			Lighting.FogEnd = 1e6
			Lighting.FogStart = 1e6
		end
	end))

	window:Notify({Title = "Void", Content = `Welcome, {localPlayer.DisplayName or localPlayer.Name}`, Duration = 5, Type = "Success"})
end)

if not mainOk then
