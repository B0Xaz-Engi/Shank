ConfigTab:CreateInput({Name = "Import JSON", PlaceholderText = "Paste config JSON here", Tooltip = "Paste an exported config JSON string", Callback = function(text)
	_importText = text
end})

ConfigTab:CreateButton({Name = "Import Config", Tooltip = "Import a config from the pasted JSON", Callback = function()
	if _importText == "" then Window:Notify({Title = "Config", Content = "Paste JSON first", Duration = 3, Type = "Error"}); return end
	local ok, parsed = pcall(function() return HttpService:JSONDecode(_importText) end)
	if not ok or type(parsed) ~= "table" or not parsed.name or not parsed.data then
		Window:Notify({Title = "Config", Content = "Invalid config JSON", Duration = 3, Type = "Error"}); return
	end
	local name = tostring(parsed.name):sub(1, 30)
	if _allConfigs[name] then name = name .. "_imported" end
	_allConfigs[name] = parsed.data
	saveAllConfigs()
	pcall(function() _configDropdown:Set(getConfigNames()) end)
	Window:Notify({Title = "Config", Content = "Imported '" .. name .. "'", Duration = 3, Type = "Success"})
end})

