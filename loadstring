local R6Parts = {["Head"]="Head",["Torso"]="Torso",["LeftArm"]="Left Arm",["RightArm"]="Right Arm",["LeftLeg"]="Left Leg",["RightLeg"]="Right Leg",["Root"]="HumanoidRootPart"}
local R15Parts = {["Head"]="Head",["Torso"]="UpperTorso",["LowerTorso"]="LowerTorso",["LeftUpperArm"]="LeftUpperArm",["LeftLowerArm"]="LeftLowerArm",["LeftHand"]="LeftHand",["RightUpperArm"]="RightUpperArm",["RightLowerArm"]="RightLowerArm",["RightHand"]="RightHand",["LeftUpperLeg"]="LeftUpperLeg",["LeftLowerLeg"]="LeftLowerLeg",["LeftFoot"]="LeftFoot",["RightUpperLeg"]="RightUpperLeg",["RightLowerLeg"]="RightLowerLeg",["RightFoot"]="RightFoot",["Root"]="HumanoidRootPart"}

local function getCharacter(player) player = player or LocalPlayer; return player and player.Character end
local function getHumanoid(player) local c = getCharacter(player); return c and c:FindFirstChildOfClass("Humanoid") end
local function getRootPart(player) local c = getCharacter(player); return c and c:FindFirstChild("HumanoidRootPart") end
local function safeTeleport(cf) local root = getRootPart(); if root then root.CFrame = cf; return true end; return false end
local function getOtherPlayerNames() local names = {}; for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(names, p.Name) end end; return names end
local function isAlly(player) if not player or not LocalPlayer then return false end; if player.Team and LocalPlayer.Team then return player.Team == LocalPlayer.Team end; return false end
local function isR15(character) return character and character:FindFirstChild("UpperTorso") ~= nil end
local function getAimbotHitpart(character) local partName = _appState.aimbotPart; if isR15(character) then return R15Parts[partName] or partName else return R6Parts[partName] or partName end end
local function isCharValid(character) return character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 and character:FindFirstChild("HumanoidRootPart") end

local function getClosestAimbotPlayer() local closestDistance = math.huge; local closestPlayer = nil; local mousePos = Vector2.new(Mouse.X, Mouse.Y); for _, player in ipairs(Players:GetPlayers()) do if player == LocalPlayer then continue end; if not isCharValid(player.Character) then continue end; local rootPart = player.Character.HumanoidRootPart; local screenPos, isVisible = Camera:WorldToViewportPoint(rootPart.Position); if not isVisible then continue end; local distance = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude; local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"); local worldDist = myRoot and (myRoot.Position - rootPart.Position).Magnitude or math.huge; if worldDist <= _appState.aimbotMaxDist and distance < closestDistance then closestPlayer = player; closestDistance = distance end end; return closestPlayer end

local function createESPData(player) if player == LocalPlayer or _espData[player] then return end; if _appState.espHiddenPlayers[player.Name] then return end; local espColor = _appState.espColor; local data = {connections = {}, tracerLine = nil, boxLines = {}}; if HAS_DRAWING and _appState.espTracers then local line = Drawing.new("Line"); line.Color = espColor; line.Thickness = SETTINGS.ESP.TRACER_THICKNESS; line.Transparency = 1 - SETTINGS.ESP.TRACER_TRANSPARENCY; line.Visible = true; data.tracerLine = line; _drawingObjects["tracer_" .. player.Name] = line end; if HAS_DRAWING and _appState.espBoxes then local boxLines = {}; for i = 1, 4 do local l = Drawing.new("Line"); l.Color = espColor; l.Thickness = SETTINGS.ESP.BOX_THICKNESS; l.Transparency = 1 - SETTINGS.ESP.BOX_TRANSPARENCY; l.Visible = true; table.insert(boxLines, l); _drawingObjects["box_" .. player.Name .. "_" .. i] = l end; data.boxLines = boxLines end; _espData[player] = data end
local function removeESPData(player) local data = _espData[player]; if not data then return end; for _, conn in ipairs(data.connections) do pcall(function() conn:Disconnect() end) end; if data.tracerLine then pcall(function() data.tracerLine:Remove() end); _drawingObjects["tracer_" .. player.Name] = nil end; for i, l in ipairs(data.boxLines or {}) do pcall(function() l:Remove() end); _drawingObjects["box_" .. player.Name .. "_" .. i] = nil end; _espData[player] = nil end
local function clearAllESP() for player in pairs(_espData) do removeESPData(player) end end
local function refreshESP() clearAllESP(); if _appState.espEnabled then for _, p in ipairs(Players:GetPlayers()) do createESPData(p) end end end

local function updateESP() _espUpdateCounter += 1; if _espUpdateCounter % SETTINGS.ESP.UPDATE_INTERVAL ~= 0 then return end; local vp = Camera.ViewportSize; for player, data in pairs(_espData) do if not player or not player.Parent then removeESPData(player); continue end; if _appState.espHiddenPlayers[player.Name] then removeESPData(player); continue end; local targetRoot = getRootPart(player); if targetRoot and data.tracerLine then local pos, onScreen = Camera:WorldToScreenPoint(targetRoot.Position); if onScreen then data.tracerLine.From = Vector2.new(vp.X / 2, vp.Y); data.tracerLine.To = Vector2.new(pos.X, pos.Y); data.tracerLine.Visible = true else data.tracerLine.Visible = false end elseif data.tracerLine then data.tracerLine.Visible = false end; if #(data.boxLines or {}) == 4 then if targetRoot then local rootPos = targetRoot.Position; local dist = (Camera.CFrame.Position - rootPos).Magnitude; local yOffset = -1 - (dist * 0.1); local root = rootPos + Vector3.new(0, yOffset, 0); local camRight = Camera.CFrame.RightVector; local top, topOn = Camera:WorldToScreenPoint(root + Vector3.new(0, 2.75, 0)); local bot, botOn = Camera:WorldToScreenPoint(root - Vector3.new(0, 2.75, 0)); local lp = Camera:WorldToScreenPoint(root + camRight * 1.75); local rp = Camera:WorldToScreenPoint(root - camRight * 1.75); if topOn and botOn then data.boxLines[1].From = Vector2.new(lp.X, top.Y); data.boxLines[1].To = Vector2.new(rp.X, top.Y); data.boxLines[1].Visible = true; data.boxLines[2].From = Vector2.new(rp.X, top.Y); data.boxLines[2].To = Vector2.new(rp.X, bot.Y); data.boxLines[2].Visible = true; data.boxLines[3].From = Vector2.new(rp.X, bot.Y); data.boxLines[3].To = Vector2.new(lp.X, bot.Y); data.boxLines[3].Visible = true; data.boxLines[4].From = Vector2.new(lp.X, bot.Y); data.boxLines[4].To = Vector2.new(lp.X, top.Y); data.boxLines[4].Visible = true else for _, l in ipairs(data.boxLines) do l.Visible = false end end else for _, l in ipairs(data.boxLines) do l.Visible = false end end end end end

local function ensureChamsFolder() if not _chamsFolder or not _chamsFolder.Parent then _chamsFolder = mk("Folder", {Name = "VoidChams", Parent = CoreGui}) end; return _chamsFolder end
local function applyChamsToChar(player, char) if not char then return end; local folder = ensureChamsFolder(); local key = "VC_" .. player.Name; for _, v in ipairs(folder:GetChildren()) do if v.Name == key then v:Destroy() end end; return mk("Highlight", {Name = key, FillColor = SETTINGS.CHAMS.FILL_COLOR, FillTransparency = SETTINGS.CHAMS.FILL_TRANSPARENCY, OutlineColor = _appState.chamsOutlineColor, OutlineTransparency = SETTINGS.CHAMS.OUTLINE_TRANSPARENCY, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = char, Parent = folder}) end
local function addChams(player) if player == LocalPlayer or _chamsData[player] then return end; local data = {connections = {}}; if player.Character then data.highlight = applyChamsToChar(player, player.Character) end; table.insert(data.connections, player.CharacterAdded:Connect(function(char) task.wait(0.2); if _appState.chamsEnabled then data.highlight = applyChamsToChar(player, char) end end)); _chamsData[player] = data end
local function removeChams(player) local data = _chamsData[player]; if not data then return end; for _, conn in ipairs(data.connections) do pcall(function() conn:Disconnect() end) end; if data.highlight and data.highlight.Parent then data.highlight:Destroy() end; if _chamsFolder and _chamsFolder.Parent then for _, v in ipairs(_chamsFolder:GetChildren()) do if v.Name == "VC_" .. player.Name then v:Destroy() end end end; _chamsData[player] = nil end
local function clearAllChams() for player in pairs(_chamsData) do removeChams(player) end; if _chamsFolder and _chamsFolder.Parent then _chamsFolder:ClearAllChildren() end end
