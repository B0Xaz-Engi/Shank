	end
	cleanupList = {}
	clearAllESP()
	clearAllChams()
	clearAllTeamChams()
	clearAllDrawings()
	destroyCrosshair()
	stopOrbit()
	if tagGui and tagGui.Parent then
		tagGui:Destroy()
