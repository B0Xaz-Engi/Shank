		chamsFolder:Destroy()
	end
	chamsFolder = nil
	if teamChamsFolder and teamChamsFolder.Parent then
		teamChamsFolder:Destroy()
	end
	teamChamsFolder = nil
	if appState.doorBypass then
		restoreDoorStates()
	end
	if appState.fullbright then
		disableFullbright()
	end
	if appState.freecam then
		disableFreecam()
	end
	if appState.hideLocalChar then
		setLocalCharVisibility(true)
	end
	if appState.bigHead then
		setBigHead(false)
	end
	for _, gui in ipairs(CoreGui:GetChildren()) do
		if gui:GetAttribute("VoidInstance") == CONFIG.GUID then
			gui:Destroy()
		end
	end
	_G[CONFIG.GUID] = nil
end

