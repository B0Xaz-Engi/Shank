-- Config System (multi-config with named profiles)
local _allConfigs = {} -- {configName = {key=value,...}, ...}
local _configCallbacks = {} -- {key = callback}
local _currentConfigData = {} -- active settings snapshot

local function ensureConfigFolder() if not HAS_FILESYSTEM then return false end; pcall(function() if not isfolder(SETTINGS.CONFIG.FOLDER) then makefolder(SETTINGS.CONFIG.FOLDER) end end); return true end
local function saveAllConfigs() if not HAS_FILESYSTEM then return end; ensureConfigFolder(); pcall(function() writefile(SETTINGS.CONFIG.FILE, HttpService:JSONEncode(_allConfigs)) end) end
local function loadAllConfigs() if not HAS_FILESYSTEM then return end; pcall(function() if isfile(SETTINGS.CONFIG.FILE) then local raw = readfile(SETTINGS.CONFIG.FILE); local parsed = HttpService:JSONDecode(raw); if type(parsed) == "table" then _allConfigs = parsed end end end) end
local function getConfigNames() local names = {}; for name in pairs(_allConfigs) do table.insert(names, name) end; table.sort(names); return names end
local function registerConfig(key, defaultVal, callback) _configCallbacks[key] = callback; if _currentConfigData[key] == nil then _currentConfigData[key] = defaultVal end end
local function setConfig(key, value) _currentConfigData[key] = value end
local function getConfig(key, default) if _currentConfigData[key] ~= nil then return _currentConfigData[key] end; return default end

local function snapshotCurrentConfig()
	local snapshot = {}
	for k, v in pairs(_currentConfigData) do snapshot[k] = v end
	return snapshot
end

local function applyConfigSnapshot(snapshot)
	if type(snapshot) ~= "table" then return end
	for k, v in pairs(snapshot) do _currentConfigData[k] = v end
	for key, callback in pairs(_configCallbacks) do
		if snapshot[key] ~= nil then pcall(callback, snapshot[key]) end
	end
end

local function applyLoadedConfigs()
	for key, callback in pairs(_configCallbacks) do
		if _currentConfigData[key] ~= nil then pcall(callback, _currentConfigData[key]) end
	end
end

-- Try to load a "Default" config on startup
local function loadDefaultOnStartup()
	loadAllConfigs()
	if _allConfigs["Default"] then
		applyConfigSnapshot(_allConfigs["Default"])
	end
end

